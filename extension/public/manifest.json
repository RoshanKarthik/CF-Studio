{
  "manifest_version": 3,
  "name": "CF Studio",
  "version": "0.1.0",
  "description": "A competitive-programming IDE on Codeforces problem pages: run the sample tests locally, submit when you're ready.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.codeforces.com/contest/*/problem/*",
        "https://*.codeforces.com/contest/*/problems",
        "https://*.codeforces.com/problemset/problem/*",
        "https://*.codeforces.com/gym/*/problem/*",
        "https://*.codeforces.com/gym/*/problems"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ide.html"
      ],
      "matches": [
        "https://*.codeforces.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
